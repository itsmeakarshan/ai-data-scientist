# AutoDS Configuration

# App & Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=true
PORT=8000
HOST=0.0.0.0

# Gemini AI API Configuration
# Get your API key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Database Configuration
# In local development, SQLite is used seamlessly by default if PostgreSQL is not active.
# In Docker Compose, PostgreSQL is automatically configured.
DATABASE_URL=sqlite+aiosqlite:///./autods.db
DATABASE_SYNC_URL=sqlite:///./autods.db
POSTGRES_USER=autods_user
POSTGRES_PASSWORD=autods_secure_password
POSTGRES_DB=autods
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# MLflow Experiment Tracking (Database-backed: SQLite for local dev, PostgreSQL / Server in Docker)
MLFLOW_TRACKING_URI=sqlite:///./data/mlflow.db
MLFLOW_EXPERIMENT_NAME=AutoDS_Default

# Security & CORS
SECRET_KEY=autods-insecure-development-secret-key-change-in-prod-32chars
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:5173","http://localhost:8000"]

# File Storage & Limits
STORAGE_DIR=./data
REPORTS_DIR=./reports
MAX_UPLOAD_SIZE_MB=100
SAFE_SQL_ROW_LIMIT=1000
